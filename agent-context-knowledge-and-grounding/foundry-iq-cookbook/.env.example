# Azure AI Search
SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
SEARCH_API_KEY=<your-search-admin-key>

# Azure OpenAI / Microsoft Foundry resource
AOAI_ENDPOINT=https://<your-foundry-resource>.openai.azure.com
AOAI_API_KEY=<your-azure-openai-key>

# Model deployments (defaults shown)
AOAI_EMBEDDING_MODEL=text-embedding-3-large
AOAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AOAI_GPT_MODEL=gpt-4o
AOAI_GPT_DEPLOYMENT=gpt-4o

# Resource names (override only if you want custom names)
INDEX_NAME=earth-at-night
KNOWLEDGE_SOURCE_NAME=earth-knowledge-source
KNOWLEDGE_BASE_NAME=earth-knowledge-base

# ---- Optional: Foundry Agent Service integration (Step 10) ----
# Only needed if you want to attach the Knowledge Base to a Foundry agent.
# The cookbook gracefully skips Step 10 when these are not set.
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
# FOUNDRY_AGENT_NAME=earth-at-night-foundry-agent
# FOUNDRY_CONNECTION_NAME=earth-at-night-foundry-connection
# FOUNDRY_AGENT_MODEL=gpt-5-mini
