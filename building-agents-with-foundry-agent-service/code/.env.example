# Copy this file to .env and fill in your own values.
# Find both values in the Microsoft Foundry portal: https://ai.azure.com

# Project endpoint - Project -> Overview -> "Azure AI Foundry project endpoint"
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# Deployed model name - Project -> Models + endpoints -> "Name" column
FOUNDRY_MODEL_NAME=gpt-4o
