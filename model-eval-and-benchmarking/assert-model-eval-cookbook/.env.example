# Required: your Azure OpenAI endpoint and key (LiteLLM convention)
AZURE_API_KEY=
AZURE_API_BASE=

# Optional: override the two candidate models the notebook compares.
# Defaults are azure/gpt-5.4-mini and azure/gpt-5.4. Use any LiteLLM model string.
ASSERT_MODEL_MINI=azure/gpt-5.4-mini
ASSERT_MODEL_FULL=azure/gpt-5.4

# Optional: per-1K-token prices for the cost-per-judged-pass column.
# Leave blank to skip cost calculation. Numbers are USD per 1000 tokens.
PRICE_GPT_5_4_MINI_INPUT_PER_1K=
PRICE_GPT_5_4_MINI_OUTPUT_PER_1K=
PRICE_GPT_5_4_INPUT_PER_1K=
PRICE_GPT_5_4_OUTPUT_PER_1K=
