# Azure OpenAI / Microsoft Foundry resource
# Used by ASSERT through LiteLLM and by the LangGraph travel-planner target.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ASSERT also reads the LiteLLM Azure variable names below.
# Keep these aligned with the Azure OpenAI values above, or let the notebook map them.
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-12-01-preview

# Candidate model deployment names in your Azure OpenAI / Foundry resource.
AZURE_DEPLOYMENT_GPT_5_4_MINI=gpt-5.4-mini
AZURE_DEPLOYMENT_GPT_5_4=gpt-5.4

# Optional: current prices for your deployments, in USD per 1K tokens.
# Leave blank to compare judged pass rate and token counts only.
PRICE_GPT_5_4_MINI_INPUT_PER_1K=
PRICE_GPT_5_4_MINI_OUTPUT_PER_1K=
PRICE_GPT_5_4_INPUT_PER_1K=
PRICE_GPT_5_4_OUTPUT_PER_1K=

# Optional: run Phoenix locally before the notebook if you want to browse traces.
# phoenix serve
